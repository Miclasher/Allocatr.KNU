@startuml
left to right direction
skinparam linetype ortho

actor "Студент" as Student
actor "Науковий керівник" as Supervisor
actor "Адміністратор" as Admin

rectangle "Система розподілу дипломних тем та курсових (Allocatr.KNU)" {
    package "Онбординг та адміністрування" {
        usecase "UC-0: Зареєструватись через corp email" as UC0
        usecase "UC-1: Пройти первинний онбординг" as UC1
        usecase "UC-2: Подати запит на роль наукового керівника" as UC2
        usecase "UC-3: Верифікувати наукового керівника" as UC3
        usecase "UC-4: Керувати кампаніями та стадіями розподілу" as UC4
        usecase "UC-11: Керування освітніми програмами" as UC11
        usecase "UC-12: Керування кафедрами" as UC12
        usecase "UC-17: Переглядати системні логи" as UC17
    }

    package "Профілі та інтереси" {
        usecase "UC-13: Заповнити профіль та наукові інтереси" as UC13
        usecase "UC-14: Переглядати каталог наукових керівників та їх інтересів" as UC14
    }

    package "Керування навантаженням" {
        usecase "UC-5: Встановити бажану квоту місць (слотів)" as UC5
    }

    package "Попередні домовленості (інвайти)" {
        usecase "UC-6: Надіслати прямий інвайт студенту" as UC6
        usecase "UC-7: Обробити інвайт від наукового керівника" as UC7
    }

    package "Конкурсний та автоматичний розподіл" {
        usecase "UC-8: Семантичний пошук наукового керівника" as UC8
        usecase "UC-9: Подати пріоритети на розподіл (пул)" as UC9
        usecase "UC-10: Запустити автоматичний розподіл студентів" as UC10
        usecase "UC-15: Виконати ручну корекцію розподілу" as UC15
    }

    package "Узгодження тем та документообіг" {
        usecase "UC-16: Запропонувати та погодити тему роботи" as UC16
        usecase "UC-18: Згенерувати та експортувати заяву на підпис" as UC18
    }
}

' Зв'язки: Студент
Student --> UC0
Student --> UC13
Student --> UC14
Student --> UC7
Student --> UC8
Student --> UC9
Student --> UC16
Student --> UC18

' Зв'язки: Науковий керівник
Supervisor --> UC0
Supervisor --> UC13
Supervisor --> UC5
Supervisor --> UC6
Supervisor --> UC16

' Зв'язки: Адміністратор
Admin --> UC3
Admin --> UC4
Admin --> UC10
Admin --> UC11
Admin --> UC12
Admin --> UC15
Admin --> UC17

' Внутрішні залежності use cases
UC0 .> UC1 : <<include>>
UC2 .> UC1 : <<extend>>
UC16 .> UC7 : <<extend>>
UC16 .> UC10 : <<extend>>
UC18 .> UC16 : <<include>>
@enduml