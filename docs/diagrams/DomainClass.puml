@startuml allocatr_domain_model
title Allocatr.KNU — Domain Model (Class Diagram)

skinparam classAttributeIconSize 0
skinparam linetype polyline
skinparam packageStyle rectangle
skinparam nodesep 60
skinparam ranksep 70
skinparam class {
    BackgroundColor<<seeded>> #F3F0FF
    BackgroundColor<<enum>> #FFF8E1
    BackgroundColor<<audit>> #FDECEC
}
hide empty members
hide <<enum>> circle

' =====================================================================
' 1. ОРГАНІЗАЦІЙНА СТРУКТУРА (seeded)
' =====================================================================
package "Організаційна структура" {

    abstract class OrganizationalUnit <<seeded>> {
        + id : UUID
        + code : String
        + nameUa : String
        + nameEn : String
        + shortName : String
        + isActive : Boolean
        + createdAt : DateTime
    }

    class Faculty <<seeded>> {
        + deanName : String
    }

    class Department <<seeded>> {
        + headName : String
    }

    class EducationalProgram {
        + id : UUID
        + code : String
        + name : String
        + specialtyCode : String
        + degreeLevel : DegreeLevel
        + durationYears : Integer
        + isActive : Boolean
    }

    class StudentGroup {
        + id : UUID
        + code : String
        + admissionYear : Integer
        + studyYear : Integer
        + departmentAssignedAt : DateTime
        + isActive : Boolean
        --
        + assignDepartment(d : Department)
    }

    OrganizationalUnit <|-- Faculty
    OrganizationalUnit <|-- Department

    Faculty "1" *-- "1..*" Department
    Faculty "1" *-- "0..*" EducationalProgram
    EducationalProgram "0..*" -- "1..*" Department : забезпечують >
    EducationalProgram "1" *-- "0..*" StudentGroup
    StudentGroup "0..*" --> "0..1" Department

    note bottom of StudentGroup
      department = null, поки кафедру
      не обрано (може бути обрана
      при вступі або пізніше).
      Інваріант: group.department ∈
      group.program.departments
    end note
}

' =====================================================================
' 2. КОРИСТУВАЧІ, РОЛІ ТА ПРОФІЛІ
' =====================================================================
package "Користувачі та профілі" {

    class UserAccount {
        + id : UUID
        + corpEmail : Email
        + firstName : String
        + lastName : String
        + middleName : String
        + status : AccountStatus
        + emailVerifiedAt : DateTime
        + onboardingCompletedAt : DateTime
        + lastLoginAt : DateTime
        + createdAt : DateTime
        --
        + hasRole(role : RoleType) : Boolean
        + isOnboarded() : Boolean
    }

    abstract class Profile {
        + id : UUID
        + role : RoleType
        + isActive : Boolean
        + grantedAt : DateTime
        + revokedAt : DateTime
    }

    abstract class AcademicProfile {
        + bio : Text
        + researchStatement : Text
        + embedding : Vector
        + embeddingUpdatedAt : DateTime
        + contactLinks : String[]
    }

    class StudentProfile {
        + studentCardNumber : String
        + gpa : Decimal [0..1]
        + gpaUpdatedAt : DateTime
        --
        + program() : EducationalProgram
        + department() : Department [0..1]
    }

    class SupervisorProfile {
        + position : String
        + academicDegree : String
        + academicTitle : String
        + verificationStatus : VerificationStatus
        + verifiedAt : DateTime
        + defaultSlotCapacity : Integer
    }

    class AdminProfile {
        + permissions : Permission[]
        --
        + can(p : Permission) : Boolean
    }

    class ResearchInterest {
        + id : UUID
        + label : String
        + description : String
        + parent : ResearchInterest
        + embedding : Vector
    }

    class SupervisorRoleRequest {
        + id : UUID
        + status : RequestStatus
        + position : String
        + justification : Text
        + submittedAt : DateTime
        + reviewedAt : DateTime
        + reviewComment : Text
        --
        + approve(by : AdminProfile)
        + reject(by : AdminProfile, reason : Text)
    }

    UserAccount "1" *-- "0..*" Profile
    UserAccount "1" *-- "0..*" SupervisorRoleRequest

    Profile <|-- AcademicProfile
    Profile <|-- AdminProfile
    AcademicProfile <|-- StudentProfile
    AcademicProfile <|-- SupervisorProfile

    AcademicProfile "0..*" o-- "0..*" ResearchInterest : цікавиться >
    ResearchInterest "0..1" -- "0..*" ResearchInterest : підтема

    SupervisorRoleRequest "0..*" --> "1" Department
    SupervisorRoleRequest "0..*" --> "0..1" AdminProfile

    StudentProfile "0..*" --> "0..1" AdminProfile

    note right of StudentProfile
      gpa = null, поки його не внесено.
      Вносити та змінювати gpa може лише
      AdminProfile з Permission.MANAGE_GPA;
      студент не може редагувати своє gpa.
      Кожна зміна фіксується в AuditLogEntry.
    end note
}

StudentProfile "0..*" --> "1" StudentGroup
SupervisorProfile "0..*" --> "1..*" Department
AdminProfile "0..*" --> "0..1" OrganizationalUnit

note right of AdminProfile
  Область адміністрування — факультет
  або кафедра; null = адміністратор
  усієї системи.
end note

' =====================================================================
' 3. КАМПАНІЇ РОЗПОДІЛУ
' =====================================================================
package "Кампанії розподілу" {

    class AllocationCampaign {
        + id : UUID
        + title : String
        + workType : WorkType
        + academicYear : String
        + targetStudyYear : Integer
        + status : CampaignStatus
        + maxPreferences : Integer
        + inviteLimitPerSupervisor : Integer
        + createdAt : DateTime
        --
        + currentStage() : CampaignStage
        + advanceStage()
    }

    class CampaignStage {
        + id : UUID
        + type : StageType
        + orderIndex : Integer
        + startsAt : DateTime
        + endsAt : DateTime
        + status : StageStatus
        --
        + isOpen(at : DateTime) : Boolean
    }

    class SupervisorQuota {
        + id : UUID
        + requestedSlots : Integer
        + approvedSlots : Integer
        + updatedAt : DateTime
        --
        + filledSlots() : Integer
        + freeSlots() : Integer
    }

    AllocationCampaign "1" *-- "1..*" CampaignStage
    AllocationCampaign "1" *-- "0..*" SupervisorQuota
}

AllocationCampaign "0..*" --> "1" EducationalProgram
AllocationCampaign "0..*" --> "1" AdminProfile
SupervisorQuota "0..*" --> "1" SupervisorProfile

' =====================================================================
' 4. ІНВАЙТИ, ЗАЯВКИ З ПРІОРИТЕТАМИ, РОЗПОДІЛ
' =====================================================================
package "Інвайти та розподіл" {

    class Invitation {
        + id : UUID
        + message : Text
        + status : InvitationStatus
        + sentAt : DateTime
        + expiresAt : DateTime
        + respondedAt : DateTime
        + declineReason : Text
        --
        + accept() : Assignment
        + decline(reason : Text)
        + revoke()
    }

    class PreferenceList {
        + id : UUID
        + status : PreferenceListStatus
        + submittedAt : DateTime
        + updatedAt : DateTime
        --
        + submit()
    }

    class PreferenceItem {
        + rank : Integer
        + motivation : Text
        + semanticScore : Decimal
        + status : PreferenceItemStatus
        + decidedAt : DateTime
        + decisionComment : Text
        --
        + accept() : Assignment
        + reject(comment : Text)
        + withdraw()
    }

    class Assignment {
        + id : UUID
        + source : AssignmentSource
        + status : AssignmentStatus
        + assignedAt : DateTime
        + matchedPreferenceRank : Integer
        + correctionReason : Text
        --
        + supersede(by : Assignment)
    }

    PreferenceList "1" *-- "1..*" PreferenceItem
    Assignment "0..1" -- "0..1" Assignment : замінює (ручна корекція) >
    Invitation "0..1" -- "0..1" Assignment : результат >
    PreferenceItem "0..1" -- "0..1" Assignment : результат (прийнята заявка) >

    note bottom of PreferenceItem
      Ручний розподіл за пріоритетами:
      • студент подає заявки з rank 1..maxPreferences;
      • заявка rank=1 одразу PENDING, решта QUEUED;
      • керівник приймає (лише якщо freeSlots() > 0)
        або відхиляє заявку;
      • при REJECTED наступна за rank заявка
        студента стає PENDING;
      • при ACCEPTED створюється Assignment,
        решта заявок студента — CANCELLED.
    end note
}

AllocationCampaign "1" *-- "0..*" Invitation
AllocationCampaign "1" *-- "0..*" PreferenceList
AllocationCampaign "1" *-- "0..*" Assignment

Invitation "0..*" --> "1" SupervisorProfile
Invitation "0..*" --> "1" StudentProfile
PreferenceList "0..*" --> "1" StudentProfile
PreferenceItem "0..*" --> "1" SupervisorProfile
Assignment "0..*" --> "1" StudentProfile
Assignment "0..*" --> "1" SupervisorProfile
Assignment "0..*" --> "0..1" AdminProfile

' =====================================================================
' 5. ТЕМИ ТА ДОКУМЕНТООБІГ
' =====================================================================
package "Теми та документи" {

    class TopicProposal {
        + id : UUID
        + titleUa : String
        + titleEn : String
        + annotation : Text
        + version : Integer
        + status : TopicStatus
        + proposedAt : DateTime
        + reviewedAt : DateTime
        + reviewComment : Text
        --
        + approve()
        + requestRevision(comment : Text)
        + reject(comment : Text)
    }

    class DocumentTemplate <<seeded>> {
        + id : UUID
        + type : DocumentType
        + name : String
        + version : Integer
        + body : Text
        + isActive : Boolean
    }

    class GeneratedDocument {
        + id : UUID
        + type : DocumentType
        + format : FileFormat
        + fileUri : String
        + checksum : String
        + generatedAt : DateTime
        + signatureStatus : SignatureStatus
    }

    GeneratedDocument "0..*" --> "1" DocumentTemplate
}

Assignment "1" *-- "0..*" TopicProposal
Assignment "1" *-- "0..*" GeneratedDocument
TopicProposal "0..*" --> "1" UserAccount
GeneratedDocument "0..*" --> "1" TopicProposal
DocumentTemplate "0..*" --> "1" OrganizationalUnit

' =====================================================================
' 6. АУДИТ
' =====================================================================
package "Аудит" {

    class AuditLogEntry <<audit>> {
        + id : UUID
        + occurredAt : DateTime
        + actorRole : RoleType
        + action : AuditAction
        + entityType : String
        + entityId : UUID
        + outcome : AuditOutcome
        + severity : AuditSeverity
        + message : String
        + failureReason : Text
        + ipAddress : String
        + userAgent : String
        + requestId : String
        + correlationId : String
    }

    class AuditFieldChange <<audit>> {
        + fieldName : String
        + oldValue : JSON
        + newValue : JSON
    }

    AuditLogEntry "1" *-- "0..*" AuditFieldChange
}

AuditLogEntry "0..*" --> "0..1" UserAccount
AuditLogEntry "0..*" --> "0..1" UserAccount
AuditLogEntry "0..*" --> "0..1" AllocationCampaign
AuditLogEntry "0..*" --> "0..1" OrganizationalUnit

note bottom of AuditLogEntry
  Append-only (без UPDATE/DELETE).
  Створюється для кожної зміни стану
  будь-якої сутності домену:
  entityType + entityId — поліморфне
  посилання, щоб лог переживав
  видалення сутностей.
  Кілька записів однієї операції
  пов'язані через correlationId.
  Зв'язки з UserAccount:
  • actor — хто виконав дію (null = система);
  • impersonatedUser — від чийого імені
    виконано дію (якщо є імперсонація).
end note

' =====================================================================
' 7. ПЕРЕЛІЧЕННЯ
' =====================================================================
package "Переліки" {
    enum RoleType <<enum>> {
        STUDENT
        SUPERVISOR
        ADMIN
    }
    enum AccountStatus <<enum>> {
        PENDING_EMAIL_VERIFICATION
        ONBOARDING
        ACTIVE
        BLOCKED
    }
    enum VerificationStatus <<enum>> {
        UNVERIFIED
        PENDING
        VERIFIED
        REVOKED
    }
    enum RequestStatus <<enum>> {
        PENDING
        APPROVED
        REJECTED
        CANCELLED
    }
    enum DegreeLevel <<enum>> {
        BACHELOR
        MASTER
        PHD
    }
    enum WorkType <<enum>> {
        COURSE_WORK
        BACHELOR_THESIS
        MASTER_THESIS
    }
    enum CampaignStatus <<enum>> {
        DRAFT
        ACTIVE
        COMPLETED
        ARCHIVED
    }
    enum StageType <<enum>> {
        QUOTA_SETUP
        DIRECT_INVITES
        PRIORITY_SUBMISSION
        APPLICATION_REVIEW
        MANUAL_CORRECTION
        TOPIC_APPROVAL
        DOCUMENTS
    }
    enum StageStatus <<enum>> {
        PLANNED
        OPEN
        CLOSED
    }
    enum InvitationStatus <<enum>> {
        PENDING
        ACCEPTED
        DECLINED
        EXPIRED
        REVOKED
    }
    enum PreferenceListStatus <<enum>> {
        DRAFT
        SUBMITTED
        LOCKED
    }
    enum PreferenceItemStatus <<enum>> {
        QUEUED
        PENDING
        ACCEPTED
        REJECTED
        WITHDRAWN
        CANCELLED
    }
    enum AssignmentSource <<enum>> {
        INVITATION
        APPLICATION
        MANUAL
    }
    enum AssignmentStatus <<enum>> {
        ACTIVE
        SUPERSEDED
        CANCELLED
    }
    enum TopicStatus <<enum>> {
        PROPOSED
        REVISION_REQUESTED
        APPROVED
        REJECTED
    }
    enum DocumentType <<enum>> {
        TOPIC_APPLICATION
        SUPERVISOR_CONSENT
    }
    enum FileFormat <<enum>> {
        PDF
        DOCX
    }
    enum SignatureStatus <<enum>> {
        NOT_SIGNED
        SIGNED_BY_STUDENT
        SIGNED_BY_SUPERVISOR
        FULLY_SIGNED
    }
    enum AuditAction <<enum>> {
        CREATE
        UPDATE
        DELETE
        LOGIN
        LOGOUT
        STATUS_CHANGE
        ROLE_GRANTED
        ROLE_REVOKED
        MANUAL_CORRECTION
        DOCUMENT_EXPORT
        EXPORT_DATA
    }
    enum AuditOutcome <<enum>> {
        SUCCESS
        FAILURE
        DENIED
    }
    enum AuditSeverity <<enum>> {
        INFO
        WARNING
        CRITICAL
    }
    enum Permission <<enum>> {
        MANAGE_CAMPAIGNS
        MANAGE_STRUCTURE
        VERIFY_SUPERVISORS
        CORRECT_ALLOCATION
        MANAGE_GPA
        VIEW_AUDIT_LOG
    }

}

@enduml
